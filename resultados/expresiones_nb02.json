{
  "Hc": "\\frac{1}{\\left(C_{0} R_{0} s + C_{0} R_{s} s + 1\\right) \\left(C_{1} C_{2} R_{1} R_{2} s^{2} + C_{2} R_{1} s + C_{2} R_{2} s + 1\\right)}",
  "T1": "\\frac{1}{C_{0} R_{0} s + C_{0} R_{s} s + 1}",
  "T2": "\\frac{1}{C_{1} C_{2} R_{1} R_{2} s^{2} + C_{2} R_{1} s + C_{2} R_{2} s + 1}",
  "wr": "\\frac{1}{C_{0} \\left(R_{0} + R_{s}\\right)}",
  "w0": "\\frac{1}{\\sqrt{C_{1}} \\sqrt{C_{2}} \\sqrt{R_{1}} \\sqrt{R_{2}}}",
  "Q": "\\frac{\\sqrt{C_{1}} \\sqrt{R_{1}} \\sqrt{R_{2}}}{\\sqrt{C_{2}} \\left(R_{1} + R_{2}\\right)}",
  "Hnb_diff": "\\frac{s \\left(C_{1} R_{2} s + 1\\right)}{C_{0} C_{1} R_{1} R_{2}}"
}